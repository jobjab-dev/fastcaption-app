# Supabase Auth + Storage
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — Supabase PostgreSQL
# Get from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Replicate (Whisper transcription)
REPLICATE_API_TOKEN=r8_your-replicate-api-token

# Omise / Opn Payments (Thai payments: TrueMoney, LINE Pay, Mobile Banking)
# Get from: https://dashboard.omise.co
OMISE_PUBLIC_KEY=pkey_test_your-omise-public-key
OMISE_SECRET_KEY=skey_test_your-omise-secret-key

# NOWPayments (Crypto: BTC, ETH, USDT, USDC)
# Get from: https://nowpayments.io
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Gemini (AI subtitle segmentation — free tier)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Admin Panel — comma-separated emails allowed to access /admin
ADMIN_EMAILS=your-admin@email.com
