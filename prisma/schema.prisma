// Prisma schema for WhisperPro commercial transcription app

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  credits       Int       @default(5000)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  transactions  Transaction[]
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileSize      Int       @default(0)
  durationSec   Float     @default(0)
  creditsUsed   Int       @default(0)
  status        String    @default("pending")
  language      String    @default("th")
  resultJson    String?
  resultAss     String?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // signup_bonus, purchase, usage
  credits     Int      // positive = add, negative = deduct
  description String
  stripeId    String?
  createdAt   DateTime @default(now())
}

model CreditPackage {
  id        String @id @default(cuid())
  name      String
  credits   Int
  priceThb  Int    // price in satang (1 baht = 100)
  stripePriceId String?
  active    Boolean @default(true)
}
