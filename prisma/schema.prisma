// Prisma schema for FastCaption — Supabase PostgreSQL
// Auth handled by Supabase Auth (no NextAuth models needed)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  supabaseUserId  String    @unique  // Supabase Auth user ID mapping
  name            String?
  email           String    @unique
  image           String?
  credits         Int       @default(5000)
  createdAt       DateTime  @default(now())
  jobs            Job[]
  transactions    Transaction[]
  apiKeys         ApiKey[]

  // Affiliate fields
  referralCode    String?   @unique
  referredBy      String?
  affiliateStatus String    @default("inactive") // inactive | active | suspended
  commissions     Commission[] @relation("AffiliateCommissions")
  payoutRequests  PayoutRequest[]
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileSize      Int       @default(0)
  durationSec   Float     @default(0)
  creditsUsed   Int       @default(0)
  status        String    @default("pending")
  language      String    @default("th")
  resultJson    String?   // JSON string (stored in DB, not file path)
  resultAss     String?
  errorMessage  String?
  replicateId   String?   // Replicate prediction ID for webhook matching
  storagePath   String?   // Supabase Storage path for uploaded audio
  source        String    @default("web")  // "web" | "app"
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // signup_bonus, purchase, usage, affiliate_commission
  credits     Int      // positive = add, negative = deduct
  description String
  stripeId    String?  @unique // Payment reference (Stripe/Omise/NOWPayments/IAP ID) — unique prevents double-credit
  gateway     String?  // stripe, omise, nowpayments, apple_iap, google_play, rewarded_ad
  source      String   @default("web")  // "web" | "app"
  createdAt   DateTime @default(now())
}

model CreditPackage {
  id        String @id @default(cuid())
  name      String
  credits   Int
  priceThb  Int    // price in satang (1 baht = 100)
  stripePriceId String?
  active    Boolean @default(true)
}

// ═══ AFFILIATE SYSTEM ═══

model AffiliateClick {
  id              String   @id @default(cuid())
  code            String
  ip              String?
  userAgent       String?
  convertedUserId String?
  createdAt       DateTime @default(now())

  @@index([code])
}

model Commission {
  id              String   @id @default(cuid())
  affiliateId     String
  affiliate       User     @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String
  transactionId   String
  amountThb       Float
  status          String   @default("pending") // pending | approved | paid
  createdAt       DateTime @default(now())

  @@index([affiliateId])
  @@index([referredUserId])
  @@unique([transactionId])
}

model PayoutRequest {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   User      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountThb   Float
  method      String    @default("bank_transfer") // bank_transfer | promptpay
  accountInfo String
  status      String    @default("pending") // pending | approved | paid | rejected
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([affiliateId])
}

// ═══ MOBILE APP — AD REWARD TRACKING ═══

model AdRewardLog {
  id        String   @id @default(cuid())
  userId    String
  credits   Int      @default(300)
  adUnitId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ═══ API KEYS (For external bot/API access) ═══

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String    @default("Default Key")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  @@index([userId])
}
